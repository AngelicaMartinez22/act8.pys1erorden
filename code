# ============================================================
# FUNCIÓN PRINCIPAL DE CÁLCULO
# ============================================================

def calcular():

    try:
        # ----------------------------------------------------
        # Obtener datos introducidos por el usuario
        # ----------------------------------------------------

        K = float(entry_K.get())
        t63 = float(entry_t63.get())

        if K <= 0 or t63 <= 0:
            raise ValueError

        # ----------------------------------------------------
        # Cálculo del 63.2 %
        # ----------------------------------------------------

        porcentaje_632 = 0.632 * K

        # Para un sistema de primer orden:
        #
        # y(tau) = 0.632 K
        #
        # Por lo tanto:
        #
        # tau = t63

        tau = t63

        # ----------------------------------------------------
        # Función de transferencia
        #
        # G(s) = K / (tau*s + 1)
        # ----------------------------------------------------

        numerador = K
        denominador_s = tau
        denominador_constante = 1

        # ----------------------------------------------------
        # Forma normalizada:
        #
        # G(s) = (K/tau)/(s + 1/tau)
        # ----------------------------------------------------

        ganancia_normalizada = K / tau
        polo = -1 / tau

        # ----------------------------------------------------
        # Mostrar resultados
        # ----------------------------------------------------

        resultado = f"""
══════════════════════════════════════════════════════════════
                 RESULTADOS DE IDENTIFICACIÓN
══════════════════════════════════════════════════════════════

1. VALOR FINAL

K = {K:.4f}


2. VALOR DEL 63.2 %

y(τ) = 0.632 K

y(τ) = 0.632({K:.4f})

y(τ) = {porcentaje_632:.4f}


3. CONSTANTE DE TIEMPO

De la gráfica:

t₆₃.₂% = {t63:.4f} s

Por definición:

τ = t₆₃.₂%

Por lo tanto:

τ = {tau:.4f} s


4. MODELO GENERAL DE PRIMER ORDEN

              K
G(s) = ─────────────
            τs + 1


5. FUNCIÓN DE TRANSFERENCIA OBTENIDA

              {K:.4f}
G(s) = ─────────────────
             {tau:.4f}s + 1


6. FORMA NORMALIZADA

G(s) = {ganancia_normalizada:.4f}
       ─────────────────────
        s + {1/tau:.4f}


7. POLO DEL SISTEMA

p = -1/τ

p = {polo:.4f}


══════════════════════════════════════════════════════════════
"""

        text_resultado.delete("1.0", tk.END)
        text_resultado.insert(tk.END, resultado)

        # ----------------------------------------------------
        # CREAR RESPUESTA DEL SISTEMA
        # ----------------------------------------------------

        t = np.linspace(0, 50, 1500)

        # Respuesta al escalón:
        #
        # y(t) = K(1-e^(-t/tau))

        y_modelo = K * (1 - np.exp(-t / tau))

        # ----------------------------------------------------
        # Curva de referencia aproximada de la imagen
        #
        # Estos puntos representan la lectura aproximada
        # de la gráfica proporcionada en el problema.
        # ----------------------------------------------------

        t_ref = np.array([
            0, 1, 2, 2.5, 3, 3.5, 4,
            4.5, 5, 6, 7, 8, 10, 12,
            15, 20, 25, 30, 35, 40, 45, 50
        ])

        y_ref = np.array([
            0,
            0,
            0.05,
            0.35,
            0.95,
            1.30,
            1.65,
            1.90,
            2.10,
            2.42,
            2.63,
            2.75,
            2.90,
            2.96,
            2.99,
            3.00,
            3.00,
            3.00,
            3.00,
            3.00,
            3.00,
            3.00
        ])

        # ----------------------------------------------------
        # Interpolar el modelo en los puntos de referencia
        # para calcular error
        # ----------------------------------------------------

        y_modelo_ref = K * (
            1 - np.exp(-t_ref / tau)
        )

        error_abs = np.mean(
            np.abs(y_ref - y_modelo_ref)
        )

        error_porcentaje = (
            error_abs / K
        ) * 100

        similitud = 100 - error_porcentaje

        # ----------------------------------------------------
        # Mostrar análisis de similitud
        # ----------------------------------------------------

        text_similitud.delete("1.0", tk.END)

        texto_similitud = f"""
══════════════════════════════════════════════════════════════
                  COMPROBACIÓN DEL MODELO
══════════════════════════════════════════════════════════════

Valor final de referencia:

K = {K:.4f}


Valor final del modelo:

K = {y_modelo[-1]:.4f}


Error absoluto promedio:

{error_abs:.4f}


Error porcentual aproximado:

{error_porcentaje:.2f}%


Similitud aproximada:

{similitud:.2f}%


INTERPRETACIÓN:

La función de transferencia obtenida genera una respuesta
de primer orden que presenta una forma similar a la curva
proporcionada en el problema.

El punto del 63.2 % se utiliza para determinar la constante
de tiempo τ.


══════════════════════════════════════════════════════════════
"""

        text_similitud.insert(
            tk.END,
            texto_similitud
        )

        # ----------------------------------------------------
        # GRAFICAR
        # ----------------------------------------------------

        ax.clear()

        # Curva de referencia
        ax.plot(
            t_ref,
            y_ref,
            linestyle="--",
            linewidth=2,
            label="Curva proporcionada"
        )

        # Modelo obtenido
        ax.plot(
            t,
            y_modelo,
            linewidth=2.5,
            label="Modelo identificado"
        )

        # Línea del 63.2 %
        ax.axhline(
            porcentaje_632,
            linestyle=":",
            linewidth=2,
            label=f"63.2 % = {porcentaje_632:.3f}"
        )

        # Línea de tau
        ax.axvline(
            tau,
            linestyle=":",
            linewidth=2,
            label=f"τ = {tau:.2f} s"
        )

        # Punto 63.2 %
        ax.scatter(
            [tau],
            [porcentaje_632],
            s=80,
            zorder=5,
            label=f"(τ, 63.2 %) = ({tau:.2f}, {porcentaje_632:.3f})"
        )

        ax.set_title(
            "Identificación de un Sistema de Primer Orden",
            fontsize=14,
            fontweight="bold"
        )

        ax.set_xlabel("Tiempo (s)")
        ax.set_ylabel("Amplitud")

        ax.set_xlim(0, 50)
        ax.set_ylim(0, 3.3)

        ax.grid(
            True,
            alpha=0.3
        )

        ax.legend(
            fontsize=8,
            loc="lower right"
        )

        canvas.draw()

    except ValueError:
        messagebox.showerror(
            "Error",
            "Introduce valores numéricos positivos."
        )


